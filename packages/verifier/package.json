{
  "name": "rashnu-verifier",
  "version": "0.1.0",
  "description": "Standalone, independently-runnable verifier for Rashnu draws: recomputes a draw's winner from public Bitcoin block data and the published ticket list, with no dependency on the Rashnu platform itself.",
  "keywords": ["lottery", "verifiable", "bitcoin", "provably-fair", "rng"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RashnuAdmin/rashnu.git",
    "directory": "packages/verifier"
  },
  "homepage": "https://github.com/RashnuAdmin/rashnu/tree/main/packages/verifier#readme",
  "bugs": "https://github.com/RashnuAdmin/rashnu/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "bin"],
  "bin": {
    "rashnu-verifier": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "node bin/cli.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
